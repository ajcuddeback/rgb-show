# Home Assistant MQTT bridge settings. Copy to /etc/rgb-show-ha.env and edit.

# Your MQTT broker. With the Mosquitto add-on this is your HA host, and the
# user/password are an HA user (Settings -> People -> Users) or the add-on login.
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# MQTT_TLS=1

# Where the rgb-show API lives (default: same Pi, behind gunicorn)
RGB_API_URL=http://127.0.0.1:8000
# Shown as the device's "Visit" link in HA (optional)
# RGB_PUBLIC_URL=http://192.168.1.50/

# How the tree appears in Home Assistant
HA_DEVICE_NAME=Christmas Tree
# HA_NODE_ID=rgb_show_tree          # change if you run more than one tree
# HA_DISCOVERY_PREFIX=homeassistant
# MQTT_TOPIC_PREFIX=rgb_show/tree
# POLL_SECONDS=2
